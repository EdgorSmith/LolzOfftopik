# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your Telegram user_id (from @userinfobot). Only this user can use the bot.
TELEGRAM_OWNER_ID=123456789

# Password the bot asks for on first /start (default: мега)
BOT_PASSWORD=мега

# lolz.live cookies (from DevTools -> Application -> Cookies on lolz.live)
LOLZ_XF_USER=
LOLZ_XF_SESSION=

# Optional: override the forum URL of "Оффтоп" section.
# Defaults to https://lolz.live/forums/offtop/
LOLZ_OFFTOP_URL=https://lolz.live/forums/offtop/

# Optional: poll interval in seconds (default 25)
POLL_INTERVAL_SECONDS=25

# Optional: HTTP port for the /health endpoint (Render sets PORT automatically)
PORT=10000

# Optional: SQLite path (default: data/state.sqlite3)
DB_PATH=data/state.sqlite3

# --- AI (Gemini) draft replies ---------------------------------------------
# When GEMINI_API_KEY is empty the feature is disabled entirely. With a key,
# the bot generates a draft reply for each new offtop thread and shows three
# buttons under it: ✅ Разрешить / 🔄 Другой вариант / ❌ Закрыть. Nothing is
# posted to the forum unless you press ✅ Разрешить. Toggle at runtime with
# /ai_on /ai_off /ai_status. Use /learn_replies to teach the model your style
# from your old offtop posts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Default state for AI drafts (per-chat override is stored via /ai_on / /ai_off).
AI_REPLY_ENABLED=0
