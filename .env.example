# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your Telegram user_id (from @userinfobot). Only this user can use the bot.
# Anyone else who messages the bot will get "⛔ Вы не создатель."
TELEGRAM_OWNER_ID=123456789

# lolz.live API token (Bearer). Get it from @LzApiBot or your account.
LOLZ_API_TOKEN=

# --- Browse / "просмотр" mode -----------------------------------------------
# Cookies from your browser session on lolz.live. The bot uses them to hit
# the *HTML* thread page for each thread it visits in 'view' mode, so
# XenForo's "members currently viewing this thread" widget shows you as
# present. Without these the feature is fully disabled.
# Get from Chrome DevTools (F12) -> Application -> Cookies -> https://lolz.live
LOLZ_XF_USER_COOKIE=
LOLZ_XF_SESSION_COOKIE=
LOLZ_XF_CSRF_COOKIE=
LOLZ_WEB_BASE=https://lolz.live

# Optional: forum URL & id of "Оффтоп" section.
LOLZ_OFFTOP_FORUM_ID=8
LOLZ_OFFTOP_URL=https://lolz.live/forums/8/

# Optional: poll interval in seconds (default 25)
POLL_INTERVAL_SECONDS=25

# Optional: HTTP port for the /health endpoint (Render sets PORT automatically)
PORT=10000

# Optional: SQLite path (default: data/state.sqlite3)
DB_PATH=data/state.sqlite3
